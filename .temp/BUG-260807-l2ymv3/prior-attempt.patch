+def _elapsed() -> float:
+    """Read this module's one monotonic clock for every deadline.
+
+    ``time.monotonic()`` is not the same clock everywhere: on Windows before
+    CPython 3.13 it is ``GetTickCount64()``, whose 15.625 ms tick makes any
+    deadline shorter than one tick unobservable — the reading does not move,
+    so an already-exhausted deadline silently admits work it was meant to
+    refuse.  ``time.perf_counter()`` is monotonic on every supported platform
+    and resolves to 100 ns on Windows for every supported CPython, so a
+    deadline means the same thing on every leg of the matrix.
+    """
+
+    return time.perf_counter()
+
