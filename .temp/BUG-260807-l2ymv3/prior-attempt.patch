diff --git a/tests/test_builds_toolchain.py b/tests/test_builds_toolchain.py
index 5f9c3d0..6962084 100644
--- a/tests/test_builds_toolchain.py
+++ b/tests/test_builds_toolchain.py
@@ -1091,3 +1091,32 @@ def test_caller_deadline_overrides_an_unusably_small_operator_value(
         timeout=toolchain.MAX_FINGERPRINT_TIMEOUT,
     )
     assert identity.algorithm == toolchain.TOOLCHAIN_ALGORITHM
+
+
+def test_an_exhausted_deadline_is_refused_on_a_coarse_grained_clock(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+):
+    """A deadline shorter than the platform clock tick must still refuse.
+
+    Windows CPython before 3.13 backs ``time.monotonic()`` with
+    ``GetTickCount64()``, which advances once every 15.625 ms.  Reading such a
+    clock twice inside one tick returns the same value, so a deadline built
+    from it looks unreached no matter how much work has run.  This stubs that
+    clock in for every platform: the fingerprint pass must still refuse the
+    toolchain, because a deadline is a refusal boundary and a coarse clock
+    must never turn it into an admission.
+    """
+
+    # A GOROOT this small hashes well inside one 15.625 ms tick, so every
+    # reading taken during the pass is the same reading.
+    monkeypatch.setattr(toolchain.time, "monotonic", lambda: 1234.5625)
+    goroot = _make_goroot(tmp_path / "trusted-go")
+    stdout = b"go version go1.25.5 %s/%s\n" % (
+        toolchain._native_host().goos.encode("ascii"),
+        toolchain._native_host().goarch.encode("ascii"),
+    )
+
+    with pytest.raises(toolchain.ToolchainError) as raised:
+        toolchain.fingerprint_toolchain(goroot, stdout, timeout=0.000001)
+    _assert_code("toolchain_timeout", raised)
