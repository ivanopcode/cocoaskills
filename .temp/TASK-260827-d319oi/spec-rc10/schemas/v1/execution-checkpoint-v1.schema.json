{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/execution-checkpoint-v1.schema.json",
  "title": "Curator verified execution checkpoint schema 1",
  "type": "object",
  "required": ["schema_version", "checkpoint_type", "operation_id", "provider", "capability_receipt_sha256", "permit_sha256", "phase", "previous_checkpoint_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint_type": {"const": "verified-execution-checkpoint-v1"},
    "operation_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "provider": {"$ref": "verified-provider-v1.schema.json"},
    "capability_receipt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "permit_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "phase": {"enum": ["permit-issued", "execution-started", "execution-succeeded"]},
    "previous_checkpoint_sha256": {"oneOf": [{"$ref": "common.schema.json#/$defs/sha256"}, {"type": "null"}]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
