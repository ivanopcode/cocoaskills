{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/execution-permit-v1.schema.json",
  "title": "Curator verified execution permit schema 1",
  "type": "object",
  "required": ["schema_version", "permit_type", "policy_id", "execution_policy", "operation_id", "provider", "capability_receipt_sha256", "build_input_sha256", "nonce", "expires_at"],
  "properties": {
    "schema_version": {"const": 1},
    "permit_type": {"const": "verified-execution-permit-v1"},
    "policy_id": {"const": "verified-provider-policy-v1"},
    "execution_policy": {"const": "verified-provider-execution-v1"},
    "operation_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "provider": {"$ref": "verified-provider-v1.schema.json"},
    "capability_receipt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "build_input_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "nonce": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
