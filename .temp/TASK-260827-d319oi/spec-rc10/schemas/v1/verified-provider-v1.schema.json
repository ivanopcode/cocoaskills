{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/verified-provider-v1.schema.json",
  "title": "Curator verified host provider descriptor schema 1",
  "type": "object",
  "required": ["schema_version", "provider_contract", "provider_id", "provider_version", "provider_binary_sha256", "operating_system"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_contract": {"const": "host-execution-provider-v1"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "provider_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "provider_binary_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "operating_system": {"enum": ["linux", "macos", "windows"]}
  },
  "additionalProperties": false
}
