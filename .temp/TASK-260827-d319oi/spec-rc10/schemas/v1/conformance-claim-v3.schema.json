{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/conformance-claim-v3.schema.json",
  "title": "Curator Protocol conformance claim schema 3",
  "type": "object",
  "required": ["schema_version", "protocol_version", "implementation", "implementation_version", "classes", "suite_sha256", "operating_systems", "build_drivers", "created_at", "result"],
  "properties": {
    "schema_version": {"const": 3},
    "protocol_version": {"const": "1.0.0-rc.5"},
    "implementation": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "implementation_version": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["core", "manager", "registry-client", "registry-service"]},
      "uniqueItems": true
    },
    "suite_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "operating_systems": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["linux", "macos", "windows"]},
      "uniqueItems": true
    },
    "build_drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["driver", "language", "execution_policy", "operating_systems"],
            "properties": {
              "driver": {"const": "go-v1"},
              "language": {"const": "go"},
              "execution_policy": {"$ref": "common.schema.json#/$defs/goExecutionPolicyV1"},
              "operating_systems": {"type": "array", "minItems": 1, "items": {"enum": ["linux", "macos", "windows"]}, "uniqueItems": true}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["driver", "language", "execution_policy", "operating_systems"],
            "properties": {
              "driver": {"const": "go-repository-v1"},
              "language": {"const": "go"},
              "execution_policy": {"$ref": "common.schema.json#/$defs/goExecutionPolicyV1"},
              "operating_systems": {"type": "array", "minItems": 1, "items": {"enum": ["linux", "macos", "windows"]}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "result": {"const": "pass"}
  },
  "additionalProperties": false
}
