        },
        "auth": {
          "kind": "none"
        }
      },
      "expect": "mcp_capability_unsupported"
    },
    {
      "id": "V12",
      "name": "tools",
      "declaration": {
        "server": {
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@example/tools@latest"
          ]
        },
        "auth": {
          "kind": "none"
        }
      },
      "expect": "mcp_runtime_pin_required"
    },
    {
      "id": "V13",
      "name": "docs",
      "declaration": {
        "server": {
          "transport": "http",
          "url": "https://example.invalid/mcp",
          "headers": {
            "Authorization": {
              "env": "DOCS_TOKEN",
              "prefix": "bearer"
