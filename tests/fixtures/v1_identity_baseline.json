          "locale": "ru",
          "skills": [
            {
              "name": "skill-a",
              "source": "repo-a",
              "ref": {
                "kind": "tag",
                "value": "v1"
              },
              "git": "git@example.com:skills/repo-a.git"
            }
          ]
        }
      }
    },
